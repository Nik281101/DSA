 #include<bits/stdc++.h>
using namespace std;

struct Student {
    int roll;
    string name;
    float marks, avg;
};

int main() {
    Student s[50];
    int n, key;

    cin >> n;
    for(int i=0;i<n;i++) {
        cin >> s[i].roll >> s[i].name >> s[i].marks;
        s[i].avg = s[i].marks;
    }

    for(int i=0;i<n;i++)
        cout << s[i].roll << " " << s[i].name << " " << s[i].marks << " " << s[i].avg << endl;

    cin >> key;
    for(int i=0;i<n;i++)
        if(s[i].roll == key)
            cout << s[i].name << " " << s[i].marks;
    return 0;
}
