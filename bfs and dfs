#include<bits/stdc++.h>
using namespace std;

int a[10][10], visited[10], n;

void DFS(int v) {
    cout<<v<<" ";
    visited[v]=1;
    for(int i=0;i<n;i++)
        if(a[v][i] && !visited[i])
            DFS(i);
}

void BFS(int v) {
    queue<int> q;
    fill(visited,visited+n,0);
    q.push(v);
    visited[v]=1;

    while(!q.empty()) {
        int x=q.front();
        q.pop();
        cout<<x<<" ";
        for(int i=0;i<n;i++)
            if(a[x][i] && !visited[i]) {
                q.push(i);
                visited[i]=1;
            }
    }
}

int main() {
    cin>>n;
    for(int i=0;i<n;i++)
        for(int j=0;j<n;j++)
            cin>>a[i][j];

    BFS(0);
    fill(visited,visited+n,0);
    cout<<"\n";
    DFS(0);
}
