#include<bits/stdc++.h>
using namespace std;

struct Node {
    int data;
    Node *next;
};

Node *front=NULL,*rear=NULL;

void enqueue(int x) {
    Node *t=new Node{x,NULL};
    if(!rear) front=rear=t;
    else {
        rear->next=t;
        rear=t;
    }
}

void dequeue() {
    if(!front) cout<<"Underflow";
    else {
        Node *t=front;
        front=front->next;
        if(!front) rear=NULL;
        delete t;
    }
}

void display() {
    Node *p=front;
    while(p) {
        cout<<p->data<<" ";
        p=p->next;
    }
}

int main() {
    enqueue(10);
    enqueue(20);
    enqueue(30);
    dequeue();
    display();
}
