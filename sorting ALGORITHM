#include<bits/stdc++.h>
using namespace std;

int main() {
    int a[100],n,key;
    cin>>n;

    for(int i=0;i<n;i++) cin>>a[i];
    cin>>key;

    for(int i=0;i<n;i++)
        if(a[i]==key) {
            cout<<"Linear Found at "<<i;
            break;
        }

    sort(a,a+n);
    int l=0,h=n-1,mid;

    while(l<=h) {
        mid=(l+h)/2;
        if(a[mid]==key) {
            cout<<"\nBinary Found at "<<mid;
            return 0;
        }
        else if(a[mid]<key) l=mid+1;
        else h=mid-1;
    }
    cout<<"\nNot Found";
}
